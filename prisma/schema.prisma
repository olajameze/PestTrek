generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  schemas   = ["public"]
}

model Company {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  name                    String?        @map("name")
  email                   String         @unique @map("email")
  phone                   String?        @map("phone")
  address                 String?        @map("address")
  website                 String?        @map("website")
  vatNumber               String?        @map("vatNumber")
  /** ISO 3166-1 alpha-2 country code set by the company owner (e.g. "IN", "GB", "US").
   *  Used as the authoritative locale source for all technicians in this company. */
  country                 String?        @map("country")
  requireSignature        Boolean?       @default(false) @map("requireSignature")
  requirePhotos           Boolean?       @default(false) @map("requirePhotos")
  defaultReportRangeDays  Int?           @default(30) @map("defaultReportRangeDays")
  notificationPreferences Json?          @map("notificationPreferences")
  stripeCustomerId        String?        @unique @map("stripeCustomerId")
  subscriptionStatus      String?        @default("trial") @map("subscriptionStatus")
  trialEndsAt             DateTime?      @map("trialEndsAt") @db.Timestamptz(6)
  paymentFailedAt         DateTime?      @map("paymentFailedAt") @db.Timestamptz(6)
  paymentGraceEndsAt      DateTime?      @map("paymentGraceEndsAt") @db.Timestamptz(6)
  nonPaymentCanceledAt    DateTime?      @map("nonPaymentCanceledAt") @db.Timestamptz(6)
  retrialGrantedAt        DateTime?      @map("retrialGrantedAt") @db.Timestamptz(6)
  /** Stripe subscription current_period_end — access through this instant on paid plans. */
  subscriptionPeriodEndAt       DateTime? @map("subscriptionPeriodEndAt") @db.Timestamptz(6)
  /** True when Stripe cancel_at_period_end is set (renewal stopped; access until subscriptionPeriodEndAt). */
  subscriptionCancelAtPeriodEnd Boolean? @default(false) @map("subscriptionCancelAtPeriodEnd")
  plan                    String?        @default("trial") @map("plan")
  invoicePrefix           String?        @default("INV") @map("invoice_prefix")
  nextInvoiceNumber       Int?           @default(1) @map("next_invoice_number")
  defaultVatRate          Decimal?       @default(20) @map("default_vat_rate") @db.Decimal(5, 2)
  createdAt               DateTime?      @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt               DateTime?      @default(now()) @updatedAt @map("updatedAt") @db.Timestamptz(6)
  logbookEntries          LogbookEntry[]
  technicians             Technician[]
  activation              CompanyActivation?
  trialUpgradeFeedback    TrialUpgradeFeedback?
  schedule                Schedule?
  appointments            Appointment[]
  recurringAppointments   RecurringAppointment[]
  customers               Customer[]
  sites                   Site[]
  invoices                Invoice[]
  complianceAlerts        ComplianceAlert[]

  @@map("Company")
  @@schema("public")
}

/// Per-company onboarding / activation milestones (trial conversion funnel).
model CompanyActivation {
  companyId                String    @id @map("company_id")
  firstCustomerCreatedAt   DateTime? @map("first_customer_created_at") @db.Timestamptz(6)
  firstSiteCreatedAt       DateTime? @map("first_site_created_at") @db.Timestamptz(6)
  firstJobCompletedAt      DateTime? @map("first_job_completed_at") @db.Timestamptz(6)
  firstPhotoUploadedAt     DateTime? @map("first_photo_uploaded_at") @db.Timestamptz(6)
  firstReportGeneratedAt   DateTime? @map("first_report_generated_at") @db.Timestamptz(6)
  checklistDismissedAt     DateTime? @map("checklist_dismissed_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company                  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("company_activation")
  @@schema("public")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  email     String   @map("email")
  endpoint  String   @unique @map("endpoint")
  p256dh    String   @map("p256dh")
  auth      String   @map("auth")
  userAgent String?  @map("userAgent")
  createdAt DateTime @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt") @db.Timestamptz(6)

  @@index([email], map: "PushSubscription_email_idx")
  @@map("PushSubscription")
  @@schema("public")
}

model Technician {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  name                    String                   @map("name")
  email                   String                   @map("email")
  companyId               String                   @map("companyId")
  createdAt               DateTime?                @default(now()) @map("createdAt") @db.Timestamptz(6)
  certifications          Certification[]
  logbookEntryTechnicians LogbookEntryTechnician[]
  appointmentTechnicians  AppointmentTechnician[]
  technicianAvailability  TechnicianAvailability[]
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("Technician")
  @@schema("public")
}

model Certification {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  technicianId String     @map("technicianId")
  fileUrl      String     @map("fileUrl")
  expiryDate   DateTime?  @map("expiryDate") @db.Timestamptz(6)
  uploadedAt   DateTime?  @default(now()) @map("uploadedAt") @db.Timestamptz(6)
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("Certification")
  @@schema("public")
}

model LogbookEntry {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId               String                   @map("companyId")
  date                    DateTime                 @map("date") @db.Timestamptz(6)
  clientName              String                   @map("clientName")
  address                 String                   @map("address")
  /** UK postcode (required for technician-submitted entries; optional for legacy rows). */
  postcode                String?                  @map("postcode")
  /** e.g. residential_house | residential_flat | commercial | agricultural | other */
  propertyType            String?                  @map("propertyType")
  treatment               String                   @map("treatment")
  notes                   String?                  @map("notes")
  photoUrl                String?                  @map("photoUrl")
  signature               String?                  @map("signature")
  rooms                   Json?                    @map("rooms")
  baitBoxesPlaced         String?                  @map("baitBoxesPlaced")
  poisonUsed              String?                  @map("poisonUsed")
  followUpDate            DateTime?                @map("followUpDate") @db.Timestamptz(6)
  internalNotes           String?                  @map("internalNotes")
  productAmount           String?                  @map("productAmount")
  recommendation          String?                  @map("recommendation")
  startTime               DateTime?                @map("startTime") @db.Timestamptz(6)
  endTime                 DateTime?                @map("endTime") @db.Timestamptz(6)
  status                  String?                  @default("open") @map("status")
  price                   Decimal?                 @map("price") @db.Decimal(10, 2)
  customerId              String?                  @map("customer_id")
  siteId                  String?                  @map("site_id")
  createdAt               DateTime?                @default(now()) @map("createdAt") @db.Timestamptz(6)
  baitStations            BaitStation[]
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer                Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  site                    Site?                    @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  logbookEntryTechnicians LogbookEntryTechnician[]
  photos                  LogbookPhoto[]
  appointment             Appointment?
  invoices                Invoice[]

  @@index([customerId], map: "logbook_entry_customer_id_idx")
  @@index([siteId], map: "logbook_entry_site_id_idx")
  @@map("LogbookEntry")
  @@schema("public")
}

model BaitStation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  logbookEntryId String       @map("logbookEntryId")
  stationId      String       @map("stationId")
  location       String       @map("location")
  baitType       String?      @map("baitType")
  amount         String?      @map("amount")
  createdAt      DateTime?    @default(now()) @map("createdAt") @db.Timestamptz(6)
  logbookEntry   LogbookEntry @relation(fields: [logbookEntryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("BaitStation")
  @@schema("public")
}

model LogbookEntryTechnician {
  logbookEntryId String       @map("logbookEntryId")
  technicianId   String       @map("technicianId")
  logbookEntry   LogbookEntry @relation(fields: [logbookEntryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technician     Technician   @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([logbookEntryId, technicianId])
  @@map("LogbookEntryTechnician")
  @@schema("public")
}

model LogbookPhoto {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  logbookEntryId String       @map("logbookEntryId")
  url            String       @map("url")
  createdAt      DateTime?    @default(now()) @map("createdAt") @db.Timestamptz(6)
  logbookEntry   LogbookEntry @relation(fields: [logbookEntryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("LogbookPhoto")
  @@schema("public")
}

/// Anonymised pest-activity facts derived from operational logbook data — no PII, separate conceptual layer from `LogbookEntry`.
model IntelligencePestEvent {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  /// Dedup key: HMAC(companyId + entryId) — cannot be reversed to recover tenant or row without the server secret.
  sourceFingerprint      String   @unique @map("source_fingerprint")
  occurredAt             DateTime @map("occurred_at") @db.Timestamptz(6)
  pestType               String   @map("pest_type")
  infestationSeverity    String   @map("infestation_severity")
  propertyType           String   @map("property_type")
  postcodeArea           String?  @map("postcode_area")
  geoLatRounded          Float?   @map("geo_lat_rounded")
  geoLngRounded          Float?   @map("geo_lng_rounded")
  treatmentMethod        String   @map("treatment_method")
  treatmentOutcome       String   @map("treatment_outcome")
  revisitRequired        Boolean  @default(false) @map("revisit_required")
  environmentalFactors   Json?    @map("environmental_factors")
  activityScore          Int      @default(0) @map("activity_score")
  season                 String?  @map("season")
  treatmentEffectiveness String?  @map("treatment_effectiveness")
  environmentalRiskScore Int?     @map("environmental_risk_score")
  ingestedAt             DateTime @default(now()) @map("ingested_at") @db.Timestamptz(6)

  @@index([occurredAt], map: "intelligence_pest_event_occurred_at_idx")
  @@index([pestType], map: "intelligence_pest_event_pest_type_idx")
  @@index([postcodeArea], map: "intelligence_pest_event_postcode_area_idx")
  @@index([treatmentOutcome], map: "intelligence_pest_event_treatment_outcome_idx")
  @@index([propertyType], map: "intelligence_pest_event_property_type_idx")
  @@map("intelligence_pest_event")
  @@schema("public")
}

model IntelligenceAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  action    String   @map("action")
  detail    Json?    @map("detail")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "intelligence_audit_log_created_at_idx")
  @@map("intelligence_audit_log")
  @@schema("public")
}

/// Captured server-side exceptions for super-admin maintenance.
model ErrorLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  message   String   @map("message") @db.Text
  stack     String?  @map("stack") @db.Text
  context   Json?    @map("context")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "error_logs_created_at_idx")
  @@map("error_logs")
  @@schema("public")
}

model WebhookError {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  provider       String    @default("stripe") @map("provider")
  eventType      String?   @map("event_type")
  stripeEventId  String?   @map("stripe_event_id")
  payload        Json?     @map("payload")
  errorMessage   String    @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  retriedAt      DateTime? @map("retried_at") @db.Timestamptz(6)

  @@index([createdAt], map: "webhook_errors_created_at_idx")
  @@map("webhook_errors")
  @@schema("public")
}

/// Public suggestion form (landing page). Inserts via API / Prisma bypass RLS.
model Suggestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  name       String?  @map("name")
  email      String?  @map("email")
  suggestion String   @map("suggestion") @db.Text
  category   String   @default("Other") @map("category")
  ipHash     String   @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipHash, createdAt], map: "suggestions_ip_created_idx")
  @@map("suggestions")
  @@schema("public")
}

/// Business admins who completed OTP signup — for marketing follow-up (super-admin dashboard).
model SignupMarketingLead {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  email        String   @unique @map("email")
  fullName     String?  @map("full_name")
  businessName String?  @map("business_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "signup_marketing_lead_created_at_idx")
  @@map("signup_marketing_lead")
  @@schema("public")
}

/// Owner objection captured when dismissing trial upgrade prompts.
model TrialUpgradeFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId String   @unique @map("company_id")
  userId    String   @map("user_id")
  userEmail String?  @map("user_email")
  reason    String   @map("reason")
  comment   String?  @map("comment") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt], map: "trial_upgrade_feedback_created_at_idx")
  @@map("trial_upgrade_feedback")
  @@schema("public")
}

model DeletionFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  userId    String   @map("user_id")
  userEmail String?  @map("user_email")
  reason    String   @map("reason") @db.Text
  comment   String?  @map("comment") @db.Text
  deletedAt DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)

  @@index([deletedAt], map: "deletion_feedback_deleted_at_idx")
  @@map("deletion_feedback")
  @@schema("public")
}

/// Server-side offline sync backlog (optional); cleared from maintenance tools.
model OfflineQueueRow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  payload   Json     @map("payload")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("offline_queue")
  @@schema("public")
}

model BackgroundJobRun {
  jobName        String    @id @map("job_name")
  lastFinishedAt DateTime? @map("last_finished_at") @db.Timestamptz(6)
  status         String?   @map("status")
  detail         Json?     @map("detail")

  @@map("background_job_runs")
  @@schema("public")
}

/// Per-company scheduling settings (Smart Scheduling module).
model Schedule {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId              String   @unique @map("company_id")
  timezone               String   @default("Europe/London") @map("timezone")
  defaultDurationMinutes Int      @default(60) @map("default_duration_minutes")
  generationHorizonDays  Int      @default(90) @map("generation_horizon_days")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("schedule")
  @@schema("public")
}

/// Recurring appointment template for Smart Scheduling.
model RecurringAppointment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId      String        @map("company_id")
  intervalType   String        @map("interval_type")
  intervalDays   Int?          @map("interval_days")
  anchorStart    DateTime      @map("anchor_start") @db.Timestamptz(6)
  endsAt         DateTime?     @map("ends_at") @db.Timestamptz(6)
  generatedUntil DateTime      @map("generated_until") @db.Timestamptz(6)
  exceptionDates Json?         @map("exception_dates")
  isActive       Boolean       @default(true) @map("is_active")
  clientName     String        @map("client_name")
  address        String        @map("address")
  postcode       String?       @map("postcode")
  treatment      String?       @map("treatment")
  notes          String?       @map("notes")
  durationMinutes Int          @default(60) @map("duration_minutes")
  customerId     String?       @map("customer_id")
  siteId         String?       @map("site_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  site           Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointments   Appointment[]

  @@index([companyId], map: "recurring_appointment_company_id_idx")
  @@index([customerId], map: "recurring_appointment_customer_id_idx")
  @@map("recurring_appointment")
  @@schema("public")
}

/// Scheduled visit (Smart Scheduling module).
model Appointment {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId              String                  @map("company_id")
  logbookEntryId         String?                 @unique @map("logbook_entry_id")
  recurringAppointmentId String?                 @map("recurring_appointment_id")
  clientName             String                  @map("client_name")
  address                String                  @map("address")
  postcode               String?                 @map("postcode")
  treatment              String?                 @map("treatment")
  notes                  String?                 @map("notes")
  scheduledStart         DateTime                @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd           DateTime                @map("scheduled_end") @db.Timestamptz(6)
  status                 String                  @default("scheduled") @map("status")
  customerId             String?                 @map("customer_id")
  siteId                 String?                 @map("site_id")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  logbookEntry           LogbookEntry?           @relation(fields: [logbookEntryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recurringAppointment   RecurringAppointment?   @relation(fields: [recurringAppointmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer               Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  site                     Site?                 @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointmentTechnicians AppointmentTechnician[]

  @@index([companyId, scheduledStart], map: "appointment_company_scheduled_start_idx")
  @@index([recurringAppointmentId], map: "appointment_recurring_id_idx")
  @@index([customerId], map: "appointment_customer_id_idx")
  @@map("appointment")
  @@schema("public")
}

model AppointmentTechnician {
  appointmentId String      @map("appointment_id")
  technicianId  String      @map("technician_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technician    Technician  @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([appointmentId, technicianId])
  @@index([technicianId], map: "appointment_technician_technician_id_idx")
  @@map("appointment_technician")
  @@schema("public")
}

/// Technician weekly or one-off availability blocks.
model TechnicianAvailability {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  technicianId  String     @map("technician_id")
  dayOfWeek     Int?       @map("day_of_week")
  specificDate  DateTime?  @map("specific_date") @db.Date
  startTime     String     @map("start_time")
  endTime       String     @map("end_time")
  isAvailable   Boolean    @default(true) @map("is_available")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  technician    Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([technicianId], map: "technician_availability_technician_id_idx")
  @@map("technician_availability")
  @@schema("public")
}

/// CRM customer record (Business+).
model Customer {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId             String                 @map("company_id")
  name                  String                 @map("name")
  email                 String?                @map("email")
  phone                 String?                @map("phone")
  notes                 String?                @map("notes") @db.Text
  archivedAt            DateTime?              @map("archived_at") @db.Timestamptz(6)
  portalEnabled         Boolean                @default(false) @map("portal_enabled")
  portalTokenHash       String?                @map("portal_token_hash")
  portalTokenExpiresAt  DateTime?              @map("portal_token_expires_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sites                 Site[]
  logbookEntries        LogbookEntry[]
  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
  invoices              Invoice[]

  @@index([companyId], map: "customer_company_id_idx")
  @@index([portalTokenHash], map: "customer_portal_token_hash_idx")
  @@map("customer")
  @@schema("public")
}

/// Service site under a customer (Business+).
model Site {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId      String           @map("company_id")
  customerId     String           @map("customer_id")
  label          String?          @map("label")
  address        String           @map("address")
  postcode       String?          @map("postcode")
  accessNotes    String?          @map("access_notes") @db.Text
  propertyType   String?          @map("property_type")
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  logbookEntries LogbookEntry[]
  appointments   Appointment[]
  recurringAppointments RecurringAppointment[]
  invoices       Invoice[]

  @@index([companyId], map: "site_company_id_idx")
  @@index([customerId], map: "site_customer_id_idx")
  @@map("site")
  @@schema("public")
}

/// Invoice for completed work (Business+).
model Invoice {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId            String        @map("company_id")
  customerId           String        @map("customer_id")
  siteId               String?       @map("site_id")
  logbookEntryId       String?       @map("logbook_entry_id")
  number               String        @map("number")
  status               String        @default("draft") @map("status")
  issuedAt             DateTime      @map("issued_at") @db.Timestamptz(6)
  dueAt                DateTime?     @map("due_at") @db.Timestamptz(6)
  subtotal             Decimal       @map("subtotal") @db.Decimal(10, 2)
  vatRate              Decimal       @map("vat_rate") @db.Decimal(5, 2)
  vatAmount            Decimal       @map("vat_amount") @db.Decimal(10, 2)
  total                Decimal       @map("total") @db.Decimal(10, 2)
  lineItems            Json          @map("line_items")
  stripePaymentLinkUrl String?       @map("stripe_payment_link_url")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site                 Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  logbookEntry         LogbookEntry? @relation(fields: [logbookEntryId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([companyId, number], map: "invoice_company_number_key")
  @@index([companyId], map: "invoice_company_id_idx")
  @@index([customerId], map: "invoice_customer_id_idx")
  @@map("invoice")
  @@schema("public")
}

/// Compliance alert for recurring visit / follow-up gaps (Business+).
model ComplianceAlert {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  companyId  String    @map("company_id")
  type       String    @map("type")
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  message    String    @map("message") @db.Text
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  emailedAt  DateTime? @map("emailed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([companyId, type, entityType, entityId], map: "compliance_alert_dedupe_key")
  @@index([companyId, resolvedAt], map: "compliance_alert_company_resolved_idx")
  @@map("compliance_alert")
  @@schema("public")
}

/// Placeholder aggregate table for chemical usage rows (may stay empty until full chemical logging ships).
model ChemicalLogRow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("chemical_logs")
  @@schema("public")
}
